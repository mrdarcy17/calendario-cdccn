<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/cdccn_fondo</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Pantalla de carga: fondo oscuro con el ícono de la app (sin el logo de Capacitor). -->
        <item name="android:background">@color/cdccn_fondo</item>
        <item name="windowSplashScreenBackground">@color/cdccn_fondo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- Bloc de notas del widget "Nota del día" -->
    <style name="Theme.Sarger.Nota" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/cdccn_fondo</item>
        <item name="colorAccent">#FACC15</item>
        <item name="colorControlActivated">#FACC15</item>
        <item name="android:textColorHighlight">#665A4D16</item>
        <item name="alertDialogTheme">@style/Theme.AppCompat.Dialog.Alert</item>
    </style>
</resources>